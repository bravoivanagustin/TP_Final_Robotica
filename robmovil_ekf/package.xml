<?xml version="1.0"?>
<package format="3">
  <name>robmovil_ekf</name>
  <version>0.0.0</version>
  <description>Localizacion EKF del robot omnidireccional sobre la libreria EKFilter (kfilter), a partir del esqueleto del taller 10</description>
  <maintainer email="francisco.raverta@gmail.com">FranciscoRaverta</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>robmovil_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>angles</depend>
  <depend>kfilter</depend>

  <exec_depend>modelo_holonomico</exec_depend>
  <exec_depend>lazo_cerrado</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
